{
  "name": "tankfit-ai",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:migrate": "tsx scripts/migrate-database.ts",
    "db:seed": "tsx scripts/seed-database.ts",
    "validate": "npm run validate:catalog && npm run validate:assets && npm run validate:security-boundaries",
    "validate:catalog": "node scripts/validate-catalog.mjs",
    "validate:assets": "node scripts/validate-assets.mjs",
    "validate:security-boundaries": "node scripts/validate-security-boundaries.mjs",
    "check": "npm run validate && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@ai-sdk/cerebras": "^3.0.55",
    "@ai-sdk/google": "^4.0.79",
    "@ai-sdk/groq": "^4.0.48",
    "@ai-sdk/provider": "^4.0.18",
    "@neondatabase/serverless": "^1.1.0",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@radix-ui/react-slot": "^1.2.3",
    "ai": "^7.0.113",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^0.577.0",
    "next": "16.3.6",
    "pdf-lib": "^1.17.1",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "stripe": "^22.6.2",
    "tailwind-merge": "^2.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
