# Server-only secrets. Copy this file to .env.local for local development.
# Never commit real credentials, and never prefix a secret with NEXT_PUBLIC_.

DATABASE_URL=
SESSION_SIGNING_SECRET=
# Stripe sandbox only. Prefer a restricted rk_test_ key with Checkout access.
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_WEBHOOK_SECRET=
# Set this to your exact preview/production origin on Vercel.
APP_ORIGIN=http://localhost:3000
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=

# Non-secret AI routing configuration. These defaults match the reviewed
# provider catalogs as of August 30, 2026.
AI_PROVIDER_ORDER=gemini,cerebras,groq,openrouter
GEMINI_MODEL=gemini-3.7-flash
CEREBRAS_MODEL=gpt-oss-120b
GROQ_MODEL=qwen/qwen3.6-27b
OPENROUTER_MODEL=openrouter/free
AI_PROVIDER_TIMEOUT_MS=7000
AI_MAX_OUTPUT_TOKENS=420
